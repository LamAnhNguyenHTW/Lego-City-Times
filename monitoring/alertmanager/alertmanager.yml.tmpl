global:
  resolve_timeout: 5m
route:
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: "default"
  routes:
    - match:
        severity: critical
      receiver: "default"
      group_wait: 10s
      repeat_interval: 1h
receivers:
  - name: "default"
    slack_configs:
      - api_url: "${SLACK_API_URL}"
        channel: "#alerts"
        send_resolved: true
        username: "Alertmanager"
        icon_emoji: ":rotating_light:"
        title: "{{ .GroupLabels.alertname }}"
        text: |
          {{ range .Alerts }}
          *Alert:* {{ .Annotations.summary }}
          *Beschreibung:* {{ .Annotations.description }}
          *Severity:* {{ .Labels.severity }}
          {{ end }}
inhibit_rules:
  - source_match:
      severity: "critical"
    target_match:
      severity: "warning"
    equal: ["alertname", "container"]
